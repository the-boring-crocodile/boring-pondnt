{
  "d365_build": {
    "name": "d365_build",
    "description": "Build a package (X++ compile and labels) as a job; dry_run shows the command only.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "module": {
          "type": "string"
        },
        "include_reports": {
          "default": false,
          "type": "boolean"
        },
        "dry_run": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "module"
      ],
      "type": "object"
    },
    "annotations": {
      "read_only_hint": false,
      "destructive_hint": true,
      "idempotent_hint": false,
      "open_world_hint": true
    }
  },
  "d365_results": {
    "name": "d365_results",
    "description": "Last compile, best_practice (of a module) or sync: totals, then errors (and warnings) as rows.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "module": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "default": "compile",
          "type": "string"
        },
        "warnings": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "limit": {
          "default": 50,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "annotations": {
      "read_only_hint": true,
      "destructive_hint": false,
      "idempotent_hint": true,
      "open_world_hint": false
    }
  },
  "d365_db_sync": {
    "name": "d365_db_sync",
    "description": "Synchronize the database as a job (given packages, or all); then d365_results kind=sync.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "modules": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "dry_run": {
          "default": false,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "annotations": {
      "read_only_hint": false,
      "destructive_hint": true,
      "idempotent_hint": false,
      "open_world_hint": true
    }
  },
  "d365_best_practice": {
    "name": "d365_best_practice",
    "description": "Run best practice checks on a model as a job; dry_run shows the command only.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "module": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "dry_run": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "module",
        "model"
      ],
      "type": "object"
    },
    "annotations": {
      "read_only_hint": false,
      "destructive_hint": true,
      "idempotent_hint": false,
      "open_world_hint": true
    }
  },
  "d365_run": {
    "name": "d365_run",
    "description": "Run d365fo.tools; timeout bounds foreground only (default up to 60 s); background returns a job. Credentials masked.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string"
        },
        "timeout": {
          "default": 60,
          "type": "integer"
        },
        "background": {
          "default": false,
          "type": "boolean"
        },
        "max_chars": {
          "default": 20000,
          "type": "integer"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    "annotations": {
      "read_only_hint": false,
      "destructive_hint": true,
      "idempotent_hint": false,
      "open_world_hint": true
    }
  },
  "d365_job": {
    "name": "d365_job",
    "description": "Job state/tail; wait_seconds 0-60 observes, stop=true requests termination. No id: list. Stop may change state.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "tail_lines": {
          "default": 40,
          "type": "integer"
        },
        "stop": {
          "default": false,
          "type": "boolean"
        },
        "wait_seconds": {
          "default": 0,
          "type": "number"
        }
      },
      "type": "object"
    },
    "annotations": {
      "read_only_hint": false,
      "destructive_hint": true,
      "idempotent_hint": false,
      "open_world_hint": false
    }
  },
  "d365_sql": {
    "name": "d365_sql",
    "description": "SQL on this box's database (GO batches): rows as JSON. Meant for test setup and checks.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "sql": {
          "type": "string"
        },
        "max_rows": {
          "default": 100,
          "type": "integer"
        },
        "timeout": {
          "default": 60,
          "type": "integer"
        },
        "atomic": {
          "default": false,
          "type": "boolean"
        },
        "database": {
          "default": "AxDB",
          "type": "string"
        }
      },
      "required": [
        "sql"
      ],
      "type": "object"
    },
    "annotations": {
      "read_only_hint": false,
      "destructive_hint": true,
      "idempotent_hint": false,
      "open_world_hint": false
    }
  },
  "xref": {
    "name": "xref",
    "description": "Compiled references: what=info | names (name) | references (path; direction used_by|uses) | hierarchy (name; down|up).",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "what": {
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "element_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "direction": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "module": {
          "type": [
            "string",
            "null"
          ]
        },
        "members": {
          "default": false,
          "type": "boolean"
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ]
        },
        "offset": {
          "default": 0,
          "type": "integer"
        }
      },
      "required": [
        "what"
      ],
      "type": "object"
    },
    "annotations": {
      "read_only_hint": true,
      "destructive_hint": false,
      "idempotent_hint": true,
      "open_world_hint": false
    }
  }
}
